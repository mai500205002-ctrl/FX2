# ── TextFX Frontend — Environment Variables ───────────────────────────────────
# Copy to .env and fill secrets locally. Do NOT commit .env.

# Leave blank for local development; Vite proxies /api to localhost:3001.
# For a hosted backend, set this to its public origin and configure backend CORS_ORIGIN.
# If the backend requires TEXTFX_API_KEY, the app uses /api/session over a trusted
# same-origin proxy or HTTPS CORS_ORIGIN. Never place the key in this file or any
# VITE_* variable. Electron exchanges it through its main-process TLS proxy.
VITE_API_URL=
