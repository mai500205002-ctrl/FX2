# ── TextFX Backend — Environment Variables ────────────────────────────────────
# Copy to .env and fill secrets locally. Do NOT commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the frontend origin when calling the backend directly.
CORS_ORIGIN=http://localhost:5000
# For an HTTPS-terminating reverse proxy, set Express TRUST_PROXY to the exact
# trusted proxy address or a narrow preset (for a local proxy, "loopback").
TRUST_PROXY=

# Optional server access key. Browser apps exchange it for a 12-hour HttpOnly
# session; remote deployments require HTTPS and CORS_ORIGIN set to the frontend
# origin. Sessions are process-local and are cleared on backend restart.
TEXTFX_API_KEY=

# ── Server-side AI providers ──────────────────────────────────────────────────
# Set one or more keys in the backend environment/Codespaces Secrets.
# Never place credentials in VITE_* variables, frontend files, or logs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: openai | openrouter | grok. Explicit provider selection requires its key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution; not a credential.
# OPENROUTER_SITE_URL=https://your-app.example
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# Auto tries configured providers in this order. A selected model requires a
# selected provider. Auto fallback only occurs after explicit request rejection.
AI_AUTO_PROVIDER_ORDER=gemini,openrouter,openai,grok

# Optional task-specific models; blank values fall back to each provider's base model.
GEMINI_MODEL_CANDIDATE_GENERATION=
GEMINI_MODEL_CRITIQUE=
GEMINI_MODEL_FINAL_ARTIFACT=
GEMINI_MODEL_UTILITY=
OPENAI_MODEL_CANDIDATE_GENERATION=
OPENAI_MODEL_CRITIQUE=
OPENAI_MODEL_FINAL_ARTIFACT=
OPENAI_MODEL_UTILITY=
OPENROUTER_MODEL_CANDIDATE_GENERATION=
OPENROUTER_MODEL_CRITIQUE=
OPENROUTER_MODEL_FINAL_ARTIFACT=
OPENROUTER_MODEL_UTILITY=
XAI_MODEL_CANDIDATE_GENERATION=
XAI_MODEL_CRITIQUE=
XAI_MODEL_FINAL_ARTIFACT=
XAI_MODEL_UTILITY=
# Optional comma-separated allow-lists; default/base/task models are enabled when unset.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet
# XAI_MODELS=grok-3-mini,grok-3

AI_TEMPERATURE=0.8
AI_MAX_OUTPUT_TOKENS=512
# Compatibility fallbacks for Gemini-only deployments.
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=512
# Process-local budgets; non-Gemini provider cost rates are estimates, not billing caps.
GEMINI_RUN_BUDGET_USD=10
GEMINI_CALL_BUDGET_USD=0.5
# Optional estimated rates per 1,000 tokens (USD); unset values use conservative defaults.
# OPENAI_INPUT_COST_USD_PER_1K=
# OPENAI_OUTPUT_COST_USD_PER_1K=
# OPENROUTER_INPUT_COST_USD_PER_1K=
# OPENROUTER_OUTPUT_COST_USD_PER_1K=
# XAI_INPUT_COST_USD_PER_1K=
# XAI_OUTPUT_COST_USD_PER_1K=

# ── Live Trends (optional) ────────────────────────────────────────────────────
# SERPAPI_KEY=REPLACE_ME_SERPAPI_KEY
# TRENDS_REGION=EG

# ── Governance Loop ───────────────────────────────────────────────────────────
# AUDIT_THRESHOLD=0.7
# MAX_RETRIES=2

# Browser Agent v1: opt-in, read-only, local single-user capability.
TEXTFX_BROWSER_ENABLED=false
# Exact HTTPS hosts only; subdomains must be listed separately.
TEXTFX_BROWSER_ALLOWED_HOSTS=example.com
# Generate a long random token; never put it in VITE_* or source control.
TEXTFX_BROWSER_TOKEN=
# Optional: override the local snapshot directory.
# TEXTFX_BROWSER_DATA_DIR=
