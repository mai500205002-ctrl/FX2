{
  "name": "textfx-backend",
  "version": "5.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pkg": "pkg dist/index.js --targets node18-win-x64 --output ../release/backend/fx-server.exe --config pkg.config.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:quality": "node --test tests/creative-quality-lab.test.cjs",
    "quality:report": "node scripts/score-creative-benchmark.cjs",
    "experiment:prepare": "node scripts/creative-experiment-orchestrator.cjs prepare",
    "experiment:finalize": "node scripts/creative-experiment-orchestrator.cjs finalize",
    "agreement:report": "node scripts/creative-inter-rater-agreement.cjs",
    "policy:review": "node scripts/creative-policy-review.cjs",
    "trial:governance": "node scripts/creative-trial-governance.cjs",
    "provenance:audit": "node scripts/creative-provenance-audit.cjs",
    "stability:report": "node scripts/creative-run-stability.cjs",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "playwright": "^1.56.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/http-errors": "^2.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^18.19.0",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/retry": "^0.12.5",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@types/strip-bom": "^4.0.1",
    "@types/strip-json-comments": "^3.0.0",
    "@vercel/ncc": "^0.38.1",
    "pkg": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ]
  }
}
