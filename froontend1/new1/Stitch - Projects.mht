@charset "utf-8";

.pulse-input { transition: box-shadow 0.3s ease-in-out; }

.pulse-input:focus { outline: none; box-shadow: rgba(0, 123, 255, 0.5) 0px 0px 5px; }

.pulse { animation: 1.5s ease 0s infinite normal none running pulse-animation; }

@keyframes pulse-animation { 
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}

.chat-footer { transition: opacity 0.3s ease-in-out; }

.chat-footer-fade-out { opacity: 0; }

.chat-footer-fade-in { opacity: 1; }
