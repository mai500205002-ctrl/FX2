# FX AI Creative Lab — backend environment
# Copy to backend/.env. Never commit real keys.
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000

# Choose one provider. OpenRouter supports multiple models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_CLOUD_PROJECT=
# VERTEX_PROJECT_ID=
# VERTEX_MODEL=gemini-1.5-pro
